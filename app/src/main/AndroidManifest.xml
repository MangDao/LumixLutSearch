<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 触感：普通权限，安装即授予。用 Vibrator 是为了让"强度"可调（见 Ui.haptic） -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- API 26~28 直接写公共 Downloads 需要；29+ 走 MediaStore 不需要 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Android 11+ 需要显式声明要查询/拉起 LUMIX Lab -->
    <queries>
        <package android:name="com.panasonic.jp.lumixlab" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 我的下载：查看/分享/管理本工具下载过的 .cube -->
        <activity
            android:name=".SongyingActivity"
            android:label="@string/songying_title"
            android:theme="@style/ChildTheme"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".DownloadsActivity"
            android:exported="false"
            android:label="@string/dl_title"
            android:theme="@style/ChildTheme"
            android:parentActivityName=".MainActivity" />

        <!-- 设置：自动更新频率 + 离线样张缓存 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/set_title"
            android:theme="@style/ChildTheme"
            android:parentActivityName=".MainActivity" />

        <!-- 搜索：历史 / 热词 / 分组结果；选中后把 code 回传主界面 -->
        <!-- 搜索页用自己的「← + 输入框 + 搜索」顶栏，所以套 AppTheme（无 ActionBar），避免出现两条返回栏 -->
        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:label="@string/search_title"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".MainActivity" />

        <!-- 编辑器：第 1 步只打通 选图 / 套 LUT / 拖浓度 -->
        <!-- 必须写全限定名：.edit.EditActivity 会按 applicationId 展开成
             io.github.lumixlut.search.edit.EditActivity，而类实际在 io.github.lumixlut.edit 包 -->
        <activity
            android:name="io.github.lumixlut.edit.EditActivity"
            android:exported="false"
            android:label="@string/edit_title"
            android:theme="@style/EditTheme"
            android:configChanges="orientation|screenSize|keyboardHidden" />

    </application>
</manifest>
