    <string name="settings_look_state_fixed_fmt">当前：%1$s（只影响本应用）</string>

    <string name="settings_foot">服务端目录实测共 199 条，本地库就是全量。\n搜索与筛选一直是纯本地 SQL（服务端无全文检索、不支持排序）。</string>

