    <string name="settings_haptic_section">触感反馈</string>
    <string name="settings_haptic_desc">Tab 切换、分段控件、收起/展开、长按删除、拖动对比把手时的一下轻振。\n强度只影响本应用；关掉开关就完全不震。</string>
    <string name="settings_haptic_switch">开启触感反馈</string>
