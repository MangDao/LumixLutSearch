    <string name="settings_sync_now">立即更新一次</string>

    <string name="settings_cache_section">离线样张缓存</string>
    <string name="settings_cache_desc_fmt">官方接口为每枚 LUT 提供两张样张（原图 + 套用效果），滑动对比就是这两张。\n默认不缓存：看图需要联网。开启后会把样张存到本地，断网也能拖对比。\n代价：约 %1$d MB 空间（存在应用缓存目录，系统清理缓存时可能被回收）。</string>
    <string name="settings_cache_switch">把官方样张缓存到本地</string>
    <string name="settings_cache_state_fmt">已缓存 %1$d 张，占 %2$d MB%3$s</string>
