<?xml version="1.0" encoding="utf-8"?>
<!--
  只用于 View.setTag(int, Object) 的键。

  用资源 ID 而不是普通对象做 tag 键，是为了避免和 View 自己的 tag 冲突 ——
  LutCardAdapter 就用了普通 setTag(Object) 挂 ViewHolder，
  如果这里也用普通 tag，两者会互相覆盖。
-->
<resources>
    <item name="facet_dim" type="id" />
    <item name="facet_store" type="id" />
    <item name="facet_draft" type="id" />
</resources>
