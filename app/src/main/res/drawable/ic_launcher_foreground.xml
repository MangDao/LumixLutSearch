<?xml version="1.0" encoding="utf-8"?>
<!--
  应用图标 · 前景层（自适应图标 foreground）：一枚放大镜，镜片是五段彩色渐变。

  规格从设备上原有的 v8 安装包里还原（aapt2 dump xmltree 读出来的路径与颜色）：
    · 把手   线 (63.99,61.94)→(85.85,85.85)，#00CDCD，宽 6.68，圆头
    · 镜片   圆心 (45.85,43.80) r=21.13，渐变 灰→浅灰→橙→粉→靛
    · 镜圈   同心圆描边 #FAFCFF 宽 6.36
    · 反光   圆弧 #3DFFFFFF 宽 1.27，圆头
  安全区：图形都落在 108x108 中间 ~66dp 的圆内，任何形状遮罩都裁不到主体。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 把手 -->
    <path
        android:pathData="M 63.99,61.94 L 85.85,85.85"
        android:strokeColor="#FF00CDCD"
        android:strokeWidth="6.68"
        android:strokeLineCap="round" />

    <!-- 镜片（彩色渐变填充） -->
    <path android:pathData="M 45.85,43.80 m -21.13,0 a 21.13,21.13 0 1,0 42.26,0 a 21.13,21.13 0 1,0 -42.26,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="24.7"
                android:startY="22.7"
                android:endX="67"
                android:endY="64.9">
                <item android:color="#FF7E8898" android:offset="0" />
                <item android:color="#FFA8B2C4" android:offset="0.42" />
                <item android:color="#FFFF8A3E" android:offset="0.44" />
                <item android:color="#FFEC528C" android:offset="0.68" />
                <item android:color="#FF565CF0" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 镜圈 -->
    <path
        android:pathData="M 45.85,43.80 m -21.13,0 a 21.13,21.13 0 1,0 42.26,0 a 21.13,21.13 0 1,0 -42.26,0"
        android:fillColor="#00000000"
        android:strokeColor="#FFFAFCFF"
        android:strokeWidth="6.36" />

    <!-- 镜面反光 -->
    <path
        android:pathData="M 27.68,46.33 a 18.17,18.17 0 0,1 27.47,-13.10"
        android:fillColor="#00000000"
        android:strokeColor="#3DFFFFFF"
        android:strokeWidth="1.27"
        android:strokeLineCap="round" />
</vector>
